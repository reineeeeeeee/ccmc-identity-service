# ccms-identity-service — copy to .env.local (the local stack does this for you).
# Tables are created automatically from the TypeORM entities on start.
DATABASE_URL=postgres://ccms_identity:ccms_identity_dev_pw@127.0.0.1:5433/ccms_identity
DB_SYNCHRONIZE=true

# Token verification (Identity publishes the public keys)
IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
JWT_ISSUER=ccms-identity
JWT_AUDIENCE=ccms

# Service-to-service shared key and the Logs service (audit events)
SERVICE_KEY=change-me-dev-service-key
LOGS_SERVICE_URL=http://127.0.0.1:3002/api

# Static assets are served through the gateway under this prefix
ASSET_PREFIX=/_ccms/identity

# Running this repo on its own port (no gateway)? The Accounts page needs the office list from the
# Catalogue repo, and the nav links to Catalogue pages (Offices, Services, Calendar) point there.
# Leave both empty when you open the system through the gateway.
CATALOGUE_SERVICE_URL=
NEXT_PUBLIC_CATALOGUE_APP_URL=
