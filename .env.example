# ccms-identity-service — copy to .env.local (the local stack does this for you).
# Tables are created automatically from the TypeORM entities on start.
DATABASE_URL=postgres://ccms_identity:ccms_identity_dev_pw@127.0.0.1:5433/ccms_identity
DB_SYNCHRONIZE=true

# Token verification (Identity publishes the public keys)
IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
JWT_ISSUER=ccms-identity
JWT_AUDIENCE=ccms

# Service-to-service shared key and the Logs service (audit events)
SERVICE_KEY=change-me-dev-service-key
LOGS_SERVICE_URL=http://127.0.0.1:3002/api

# This repo has the gateway built in: `npm run dev` starts it, and open http://localhost:3001.
# Pages and APIs of the other repos are passed through to them. Where they run (defaults shown):
#   CATALOGUE_URL=http://127.0.0.1:3003
#   LOGS_URL=http://127.0.0.1:3002
# Keep ASSET_PREFIX as is (it lets several apps share one address) and leave NEXT_PUBLIC_CATALOGUE_APP_URL empty.
ASSET_PREFIX=/_ccms/identity
NEXT_PUBLIC_CATALOGUE_APP_URL=

# Server-to-server: Identity checks an account's office with the Catalogue service.
CATALOGUE_SERVICE_URL=http://127.0.0.1:3003/api

# Email (password reset links). Pick ONE; with none set, the email is only printed in this server's console.
# Option A: SMTP, e.g. Gmail with an App Password (Google Account > Security > 2-Step Verification > App passwords)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   EMAIL_FROM="CCMS <yourname@gmail.com>"
# Option B: a generic HTTP mail API
#   EMAIL_API_URL=
#   EMAIL_API_KEY=
