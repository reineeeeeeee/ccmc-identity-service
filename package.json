{
  "name": "ccms-identity-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "ccms": {
    "service": "identity",
    "port": 3001
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3001",
    "lint": "eslint .",
    "check:time": "ccms-check-time src scripts",
    "test": "node --test \"test/**/*.test.js\"",
    "db:sync": "node --env-file-if-exists=.env.local scripts/sync-db.js",
    "ci": "npm run lint && npm run check:time && npm test && npm run build",
    "bootstrap:admin": "node --env-file-if-exists=.env.local scripts/bootstrap-super-admin.js"
  },
  "dependencies": {
    "ccms-shared": "file:./vendor/ccms-shared",
    "jose": "^6.2.0",
    "next": "^16.3.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0"
  }
}